{"rules": [
  {"id": "no-poly-handlers", "type": "forbidden_path", "path_regex": "core/poly/src/handlers/",
   "why": "poly is binder/surfaces only"},
  {"id": "no-commands-dirs", "type": "forbidden_path", "path_regex": "/commands/",
   "why": "use src/handlers/, not commands/"},
  {"id": "handlers-in-handlers", "type": "required_location", "file_regex": "\\.handler\\.(ts|js)$", "dir_regex": "src/handlers/",
   "why": "handler files only under src/handlers/"},
  {"id": "plugins-no-core-internals", "type": "import_boundary", "source_regex": "^plugins/",
   "forbidden_import_regex": "core/[^/]+/src/", "allowed_import_regex": "core/[^/]+/contracts?",
   "why": "plugins couple through contracts only"},
  {"id": "stale-example", "type": "forbidden_path", "path_regex": "legacy_dir_that_is_gone/",
   "why": "should trigger the stale-rule warning"}
]}
