        {"id": "enumeration", "module": null, "how": "explicit DFS over the finite node set"}
      ],
      "minimum_agreeing": 2,
      "cases": {
        "positive": {"nodes": ["a", "b", "c"], "edges": [["a", "b"], ["b", "c"]]},
        "negative": {"nodes": ["a", "b", "c"], "edges": [["a", "b"], ["b", "c"], ["c", "a"]]}
      }
    },
    "graph.reaches_all": {
