{
  "schema": "cb.decider_registry.v1",
  "question_kinds": {
    "graph.is_acyclic": {
      "deciders": [
        {"id": "rustworkx", "module": "rustworkx", "how": "PyDiGraph plus is_directed_acyclic_graph"},
        {"id": "networkx", "module": "networkx", "how": "DiGraph plus is_directed_acyclic_graph"},
