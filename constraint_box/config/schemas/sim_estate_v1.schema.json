{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintbox.local/schemas/sim_estate_v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "promotion_allowed",
    "python",
    "controller_sha256",
    "worker_sha256",
    "import_blocker_sha256",
    "layers"
  ],
  "properties": {
    "schema": {"const": "constraintbox.sim-estate.v1"},
    "status": {"const": "PROPOSED"},
    "promotion_allowed": {"const": false},
    "python": {"type": "string"},
    "controller_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "import_blocker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer_id", "name", "boot_budget_seconds", "capabilities"],
        "properties": {
          "layer_id": {"type": "string", "pattern": "^E[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "boot_budget_seconds": {"type": "number", "exclusiveMinimum": 0},
          "tested_lock": {"type": "string"},
          "tested_lock_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_capability_sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "required", "locked_version"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "locked_version": {"type": ["string", "null"]},
                "python": {"type": "string"},
                "artifact_sha1": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "unevaluatedProperties": false
            }
          }
        },
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
