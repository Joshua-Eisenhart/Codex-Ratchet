#!/usr/bin/env python3
"""Public launcher for the integrated ConstraintBox source/bundle."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import platform
import shutil
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any, Mapping


# Public v1 authority is intentionally narrow and explicit.  Candidate
# definitions are discovered, but only this fixed direct cohort can be ACTIVE.
REQUIRED_ACTIVE_WAVE_IDS = frozenset(
    {
        "cb-maintenance-wave",
        "cb-context-strategy-wave",
        "cb-exploration-wave",
    }
)
REQUIRED_ACTIVE_DEFINITION_IDS = {
    wave_id: f"{wave_id}-v1" for wave_id in REQUIRED_ACTIVE_WAVE_IDS
}


def roots() -> tuple[Path, Path, Path]:
    here = Path(__file__).resolve()
    bundle_root = here.parents[1]
    bundled_box = bundle_root / "PROJECT" / "constraint_box"
    if bundled_box.is_dir():
        return bundle_root, bundled_box, bundled_box / "integrated_system"
    box_root = here.parents[2]
    return box_root.parent, box_root, box_root / "integrated_system"


def declared_python(value: str | None, fallback: Path) -> Path:
    path = Path(value).expanduser().absolute() if value else fallback.absolute()
    if not path.is_file() or not os.access(path, os.X_OK):
        raise SystemExit(f"HOLD_INTERPRETER_MISSING:{path}")
    return path


def default_jax_python() -> Path | None:
    """Return the project-neutral JAX/QIT runtime, if it is installed."""

    configured = os.environ.get("CB_JAX_QIT_ROOT")
    root = (
        Path(configured).expanduser()
        if configured
        else Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
        / "jax-qit-stack"
    )
    for name in ("python", "python3"):
        candidate = root / "bin" / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    return None


def run(argv: list[str], *, cwd: Path, env: dict[str, str] | None = None) -> int:
    return subprocess.run(argv, cwd=cwd, env=env, check=False).returncode


def run_provider_zip(
    args: list[str],
    *,
    box: Path,
    system: Path,
    light: Path,
    env: dict[str, str],
) -> int:
    """Run one provider-backed ZIP under a short-lived CB dispatch lease."""

    if not args or args[0] != "run":
        return run(
            [light, "-m", "constraintbox_zip_agent.single_provider_child", *args],
            cwd=Path.cwd(),
            env=env,
        )
    controller = system / "runtime" / "controller_src" / "constraintbox"
    if not controller.is_dir():
        controller = box / "src" / "constraintbox"
    hook_source = controller / "hook_adapter.py"
    if not hook_source.is_file():
        raise SystemExit("HOLD_PROVIDER_CONTROLLER_UNBOUND")
    spec = importlib.util.spec_from_file_location(
        "constraintbox_provider_dispatch_lease", hook_source
    )
    if spec is None or spec.loader is None:
        raise SystemExit("HOLD_PROVIDER_DISPATCH_LEASE_UNAVAILABLE")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    packet = Path(args[1]).expanduser().absolute() if len(args) > 1 else None
    identity = (
        "provider-zip-" + sha256_file(packet)[:24]
        if packet is not None and packet.is_file()
        else "provider-zip-run"
    )
    with module.issue_dispatch_lease(identity) as (overlay, _metadata):
        child_env = dict(env)
        child_env.update(overlay)
        return run(
            [light, "-m", "constraintbox_zip_agent", *args],
            cwd=Path.cwd(),
            env=child_env,
        )


def bootstrap_light(box: Path) -> int:
    """Create and populate the contained Light runtime on a fresh extraction."""

    if sys.version_info[:2] != (3, 13):
        print(
            json.dumps(
                {
                    "schema": "constraintbox.integrated-bootstrap.v1",
                    "status": "HOLD",
                    "reason_code": "HOLD_BOOTSTRAP_REQUIRES_PYTHON_3_13",
                    "observed_python": platform.python_version(),
                    "promotion_allowed": False,
                },
                sort_keys=True,
            )
        )
        return 2
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        print(
            json.dumps(
                {
                    "schema": "constraintbox.integrated-bootstrap.v1",
                    "status": "HOLD",
                    "reason_code": "HOLD_BOOTSTRAP_REQUIRES_MACOS_ARM64_LOCK",
                    "observed_platform": platform.system(),
                    "observed_machine": platform.machine(),
                    "promotion_allowed": False,
                },
                sort_keys=True,
            )
        )
        return 2
    required = [
        box / "scripts" / "cb_light_cli.py",
        box / "requirements" / "locks" / "constraintbox-py313-macos-estate.lock",
        box / "light_runtime" / "pyproject.toml",
    ]
    missing = [str(path) for path in required if not path.is_file()]
    if missing:
        print(
            json.dumps(
                {
                    "schema": "constraintbox.integrated-bootstrap.v1",
                    "status": "REFUSE",
                    "reason_code": "REFUSE_BOOTSTRAP_SOURCE_INCOMPLETE",
                    "missing_paths": missing,
                    "promotion_allowed": False,
                },
                sort_keys=True,
            )
        )
        return 2
    target = box / ".venv"
    builder = box / ".bootstrap-light-build"
    created = subprocess.run(
        [sys.executable, "-m", "venv", "--clear", str(builder)], cwd=box, check=False
    )
    if created.returncode != 0:
        return created.returncode
    builder_python = builder / "bin" / "python"
    build_backend = subprocess.run(
        [
            str(builder_python),
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--quiet",
            "--isolated",
            "--no-input",
            "setuptools>=68",
        ],
        cwd=box,
        check=False,
    )
    if build_backend.returncode != 0:
        shutil.rmtree(builder, ignore_errors=True)
        return build_backend.returncode
    bootstrap_env = os.environ.copy()
    bootstrap_env.update(
        {
            "PYTHONNOUSERSITE": "1",
            "PYTHONDONTWRITEBYTECODE": "1",
            "PYTHONPATH": str(box / "light_runtime" / "src"),
            "CB_LIGHT_ROOT": str(box),
            "CB_LIGHT_BUILD_INTERPRETER": str(builder_python),
        }
    )
    installed = subprocess.run(
        [
            str(builder_python),
            str(box / "scripts" / "cb_light_cli.py"),
            "install",
            "--rebuild-manifest",
        ],
        cwd=box,
        env=bootstrap_env,
        check=False,
    )
    if installed.returncode != 0:
        shutil.rmtree(builder, ignore_errors=True)
        return installed.returncode
    contained = target / "bin" / "python"
    return subprocess.run(
        [
            str(contained),
            "-B",
            "-I",
            str(box / "scripts" / "cb_light_cli.py"),
            "status",
        ],
        cwd=box,
        check=False,
    ).returncode


def runtime_env(box: Path, system: Path, light_python: Path) -> dict[str, str]:
    env = os.environ.copy()
    controller = system / "runtime" / "controller_src"
    zip_runtime = system / "runtime" / "zip_agent_src"
    source_roots = [
        str(zip_runtime if zip_runtime.is_dir() else box / "zip_agent" / "src")
    ]
    if controller.is_dir():
        source_roots.append(str(controller))
    else:
        source_roots.append(str(box / "light_runtime" / "src"))
    env.update(
        {
            "PYTHONNOUSERSITE": "1",
            "PYTHONDONTWRITEBYTECODE": "1",
            "CB_BOX_ROOT": str(box),
            "CB_SKILLS_ROOT": str(system / "skills"),
            "CB_MMM_ROOT": str(system / "mmms" / "primary"),
            "CB_MMM_PACKS_ROOT": str(box / "mmm" / "packs"),
            "CB_LIGHT_PYTHON": str(light_python),
            "CB_LIGHT_ROOT": str(box),
            "CB_LIGHT_INTERPRETER": str(light_python),
            "CB_CONTROLLER_SRC": str(controller if controller.is_dir() else box / "src"),
            "PYTHONPATH": os.pathsep.join(source_roots),
        }
    )
    build_python = box / ".bootstrap-light-build" / "bin" / "python"
    if build_python.is_file():
        env["CB_LIGHT_BUILD_INTERPRETER"] = str(build_python)
    return env


def probe_module(python: Path, module: str) -> dict[str, object]:
    code = (
        "import importlib,json,pathlib,sys; "
        "m=importlib.import_module(sys.argv[1]); "
        "print(json.dumps({'module':sys.argv[1],'version':str(getattr(m,'__version__',None)),'origin':getattr(m,'__file__',None),'executable':sys.executable,'realpath':str(pathlib.Path(sys.executable).resolve()),'prefix':sys.prefix},sort_keys=True))"
    )
    proc = subprocess.run(
        [str(python), "-I", "-c", code, module],
        check=False,
        capture_output=True,
        text=True,
        timeout=60,
    )
    if proc.returncode != 0:
        return {
            "status": "HOLD",
            "module": module,
            "returncode": proc.returncode,
            "stderr": (proc.stderr or "")[-500:],
        }
    return {"status": "PASS", **json.loads(proc.stdout)}


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _regular_confined(path: Path, root: Path, *, directory: bool = False) -> bool:
    """Require a non-symlink regular path whose resolved target stays in root."""

    try:
        mode = path.lstat().st_mode
        if path.is_symlink():
            return False
        if directory:
            if not stat.S_ISDIR(mode):
                return False
        elif not stat.S_ISREG(mode):
            return False
        root_absolute = root.absolute()
        path_absolute = path.absolute()
        relative = path_absolute.relative_to(root_absolute)
        current = root_absolute
        if current.is_symlink():
            return False
        for component in relative.parts:
            current = current / component
            if current.is_symlink():
                return False
        resolved = path.resolve(strict=True)
        resolved.relative_to(root.resolve(strict=True))
        return True
    except (OSError, ValueError):
        return False


def _fixed_skills_root(system: Path) -> Path | None:
    """Return the product-owned skills root, rejecting a symlinked root."""

    skills = system / "skills"
    if not _regular_confined(skills, system, directory=True):
        return None
    return skills.resolve(strict=True)


def _tree_security_findings(skill_dir: Path, skills_root: Path) -> list[str]:
    """Inspect a skill tree without following symlinked directories."""

    findings: list[str] = []
    if not _regular_confined(skill_dir, skills_root, directory=True):
        return ["SYMLINKED_OR_OUTSIDE_SKILL_DIR"]
    for base, dirs, files in os.walk(skill_dir, followlinks=False):
        for name in [*sorted(dirs), *sorted(files)]:
            item = Path(base) / name
            relative = item.relative_to(skill_dir).as_posix()
            try:
                if item.is_symlink():
                    findings.append(f"SYMLINKED_PATH:{relative}")
                    continue
                resolved = item.resolve(strict=True)
                resolved.relative_to(skills_root.resolve(strict=True))
            except (OSError, ValueError):
                findings.append(f"PATH_OUTSIDE_SKILLS_ROOT:{relative}")
    return findings


def _sha256_tree(path: Path) -> str:
    """Hash a wave skill tree in a stable order, ignoring generated noise."""

    if path.is_file():
        return sha256_file(path)
    digest = hashlib.sha256()
    files = [
        item
        for item in path.rglob("*")
        if item.is_file()
        and "__pycache__" not in item.relative_to(path).parts
        and ".pytest_cache" not in item.relative_to(path).parts
        and item.suffix not in {".pyc", ".pyo"}
    ]
    for item in sorted(files, key=lambda value: value.relative_to(path).as_posix()):
        relative = item.relative_to(path).as_posix().encode("utf-8")
        digest.update(len(relative).to_bytes(8, "big"))
        digest.update(relative)
        digest.update(sha256_file(item).encode("ascii"))
    return digest.hexdigest()


def _relative_product_path(path: Path, root: Path) -> str | None:
    try:
        return path.resolve(strict=False).relative_to(root.resolve(strict=True)).as_posix()
    except (OSError, ValueError):
        return None


def _sanitize_public_paths(value: Any) -> Any:
    """Redact absolute path strings before exposing a catalog response."""

    if isinstance(value, dict):
        return {key: _sanitize_public_paths(item) for key, item in value.items()}
    if isinstance(value, list):
        return [_sanitize_public_paths(item) for item in value]
    if isinstance(value, tuple):
        return tuple(_sanitize_public_paths(item) for item in value)
    if isinstance(value, str) and (value.startswith("/") or value.startswith("~/")):
        return "<outside-path-redacted>"
    return value


def _manifest_path_key(value: object) -> str | None:
    """Normalize manifest wave paths without allowing an outside reference."""

    if not isinstance(value, str) or not value.strip():
        return None
    raw = Path(value).as_posix()
    if raw.startswith("/") or "\\" in value:
        return None
    parts = [part for part in raw.split("/") if part not in ("", ".")]
    if ".." in parts:
        return None
    if parts[:1] != ["skills"]:
        parts.insert(0, "skills")
    if len(parts) < 3 or parts[-1] != "wave.json":
        return None
    return "/".join(parts)


def _manifest_confined_path(
    value: object,
    *,
    system: Path,
    skills_root: Path,
    require_skills_prefix: bool = True,
) -> tuple[str | None, Path | None]:
    """Normalize and confine a manifest file path to the fixed skills root."""

    if not isinstance(value, str) or not value.strip():
        return None, None
    # Active bindings are intentionally canonical product paths.  Do not
    # reinterpret a bare or host path as a contained path.
    if require_skills_prefix and not value.startswith("skills/"):
        return None, None
    raw = Path(value).as_posix()
    if raw.startswith("/") or "\\" in value:
        return None, None
    parts = [part for part in raw.split("/") if part not in ("", ".")]
    if ".." in parts or len(parts) < 2:
        return None, None
    if parts[:1] != ["skills"]:
        if require_skills_prefix:
            return None, None
        parts.insert(0, "skills")
    key = "/".join(parts)
    candidate = system / key
    if not _regular_confined(candidate, skills_root):
        return None, None
    return key, candidate


def _manifest_confined_file(
    value: object,
    *,
    system: Path,
    skills_root: Path,
    require_skills_prefix: bool = True,
) -> tuple[str | None, Path | None]:
    key, candidate = _manifest_confined_path(
        value,
        system=system,
        skills_root=skills_root,
        require_skills_prefix=require_skills_prefix,
    )
    if key is None or candidate is None or not key.endswith("/wave.json"):
        return None, None
    return key, candidate


def _manifest_wave_id(value: object) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return None
    raw = value.rstrip("/")
    if raw.endswith("/wave.json"):
        raw = raw[: -len("/wave.json")]
    if raw.endswith(".json"):
        raw = raw.rsplit("/", 1)[-1][:-5]
    return Path(raw).name or None


def _read_active_wave_manifest(system: Path) -> dict[str, Any]:
    """Read active authority as observation; never repair or rewrite it."""

    path = system / "skills" / "ACTIVE_WAVES.json"
    result: dict[str, Any] = {
        "path": _relative_product_path(path, system),
        "exists": path.is_file(),
        "sha256": None,
        "available": False,
        "errors": [],
        "data": {},
    }
    if not path.is_file():
        result["errors"] = [
            "manifest_missing" if not path.exists() else "active_manifest_not_confined"
        ]
        result["sha256"] = None
        return result
    if not _regular_confined(path, system / "skills"):
        result["errors"] = ["active_manifest_not_confined"]
        result["sha256"] = None
        return result
    result["sha256"] = sha256_file(path)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        result["errors"] = [f"invalid_json:{type(exc).__name__}:{exc}"]
        return result
    if not isinstance(value, dict):
        result["errors"] = ["manifest_not_object"]
        return result
    if value.get("schema") != "constraintbox.active-wave-set.v1":
        result["errors"] = ["manifest_schema"]
        return result
    skills_root = _fixed_skills_root(system)
    if skills_root is None:
        result["errors"] = ["skills_root_not_confined"]
        return result
    errors: list[str] = []
    rows = value.get("runnable_cohort")
    if not isinstance(rows, list):
        errors.append("runnable_cohort_shape")
        rows = []
    seen_ids: set[str] = set()
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("wave_id"), str):
            errors.append("active_manifest_wave_id_shape")
            continue
        wave_id = row["wave_id"]
        if wave_id in seen_ids:
            errors.append(f"duplicate_active_manifest_wave_id:{wave_id}")
        seen_ids.add(wave_id)
        definition_key, _definition_path = _manifest_confined_file(
            row.get("definition"), system=system, skills_root=skills_root
        )
        if definition_key is None:
            errors.append("active_manifest_definition_not_confined")
        script_key, _script_path = _manifest_confined_path(
            row.get("script"), system=system, skills_root=skills_root
        )
        if script_key is None:
            errors.append("active_manifest_script_not_confined")
        skill_key, _skill_path = _manifest_confined_path(
            row.get("skill"), system=system, skills_root=skills_root
        )
        if skill_key is None:
            errors.append("active_manifest_skill_not_confined")
        elif definition_key is not None:
            expected_skill_key = definition_key.rsplit("/", 1)[0] + "/SKILL.md"
            if skill_key != expected_skill_key:
                errors.append("active_manifest_skill_path_mismatch")
        for key in ("definition_sha256", "script_sha256"):
            digest = row.get(key)
            if not isinstance(digest, str) or len(digest) != 64:
                errors.append(f"active_manifest_{key}_missing")
        skill_digest = row.get("skill_sha256")
        if not isinstance(skill_digest, str) or len(skill_digest) != 64:
            errors.append("active_manifest_skill_sha256_missing")
    for declared_value in value.get("wave_definitions", []) or []:
        key, _path = _manifest_confined_file(
            declared_value,
            system=system,
            skills_root=skills_root,
            require_skills_prefix=False,
        )
        if key is None:
            errors.append("active_manifest_declared_definition_not_confined")
    if value.get("zip_wave_definition") is not None:
        key, _path = _manifest_confined_file(
            value.get("zip_wave_definition"),
            system=system,
            skills_root=skills_root,
            require_skills_prefix=False,
        )
        if key is None:
            errors.append("active_manifest_zip_definition_not_confined")
    if errors:
        result["errors"] = sorted(set(errors))
        return result
    result["available"] = True
    result["data"] = value
    return result


def _load_wave_validator(skills_root: Path):
    """Load only the fixed contained validator, never candidate-local code."""

    validator = skills_root / "cb-wave-author" / "scripts" / "validate_wave.py"
    if not _regular_confined(validator, skills_root):
        return validator, None, ["trusted_validator_not_confined"]
    try:
        spec = importlib.util.spec_from_file_location(
            "constraintbox_public_wave_validator", validator
        )
        if spec is None or spec.loader is None:
            raise ImportError("spec_or_loader_missing")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return validator, module, []
    except Exception as exc:  # pragma: no cover - defensive import boundary
        return validator, None, [f"validator_import:{type(exc).__name__}:{exc}"]


def _validate_wave_definition(path: Path, skills_root: Path) -> dict[str, Any]:
    """Run the existing definition and tree validators without activation."""

    validator, module, setup_errors = _load_wave_validator(skills_root)
    validation: dict[str, Any] = {
        "validator": _relative_product_path(validator, skills_root.parent),
        "validator_available": module is not None,
        "definition_errors": [],
        "tree_errors": [],
        "errors": list(setup_errors),
    }
    if module is None:
        validation["disposition"] = "REFUSE_WAVE_DEFINITION"
        return validation
    try:
        raw = path.read_text(encoding="utf-8")
        data = json.loads(raw)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        # Keep the validator's established CLI error vocabulary, while adding
        # a typed parse marker so invalid JSON cannot be confused with a
        # valid definition whose child skill is absent.
        detail = f"read:{type(exc).__name__}:{exc}"
        validation["parse_error"] = {
            "code": "INVALID_JSON",
            "type": type(exc).__name__,
            "message": str(exc),
        }
        validation["definition_errors"] = [detail]
        validation["errors"] = ["invalid_json:" + type(exc).__name__, detail]
        validation["disposition"] = "REFUSE_WAVE_DEFINITION"
        return validation
    if not isinstance(data, dict):
        detail = f"definition_not_object:{type(data).__name__}"
        validation["definition_errors"] = [detail]
        validation["errors"] = [detail]
        validation["disposition"] = "REFUSE_WAVE_DEFINITION"
        return validation
    try:
        # The general wave-author validator consumes parsed data and exposes a
        # separate tree check.  ZIP-native definitions retain their own
        # validator, whose established API consumes the definition path and
        # folds child-skill checks into its findings.
        if hasattr(module, "validate_tree"):
            definition_errors = list(module.validate(data))
            tree_errors = list(module.validate_tree(data, skills_root))
        else:
            definition_errors = list(module.validate(path))
            tree_errors = []
    except Exception as exc:  # pragma: no cover - validator contract guard
        detail = f"validator_error:{type(exc).__name__}:{exc}"
        validation["errors"] = [detail]
        validation["disposition"] = "REFUSE_WAVE_DEFINITION"
        return validation
    validation["definition_errors"] = definition_errors
    validation["tree_errors"] = tree_errors
    validation["errors"] = definition_errors + tree_errors
    validation["disposition"] = (
        "WAVE_DEFINITION_VALID" if not validation["errors"] else "REFUSE_WAVE_DEFINITION"
    )
    return validation


def _public_wave_module(system: Path):
    script = system / "scripts" / "run_wave.py"
    if not script.is_file():
        return None
    try:
        spec = importlib.util.spec_from_file_location(
            "constraintbox_public_wave_runner", script
        )
        if spec is None or spec.loader is None:
            return None
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except Exception:  # pragma: no cover - source/bundle compatibility guard
        return None


def _wave_catalog_membership(
    *,
    public_id: str,
    path_key: str,
    definition_path: Path,
    definition_wave_id: str | None,
    definition_sha256: str | None,
    skill_sha256: str | None,
    system: Path,
    skills_root: Path,
    manifest: Mapping[str, Any],
) -> tuple[str, str, list[str]]:
    """Classify only after exact confined manifest binding checks."""

    if not manifest.get("available"):
        errors = [str(value) for value in manifest.get("errors", [])]
        return "UNREGISTERED_CANDIDATE", "active_manifest_blocked", errors
    data = manifest.get("data") or {}
    rows: list[dict[str, Any]] = []
    for row in data.get("runnable_cohort", []) or []:
        if not isinstance(row, dict):
            continue
        rows.append(row)
    for row in rows:
        row_id = row.get("wave_id")
        row_path, _row_definition_path = _manifest_confined_file(
            row.get("definition"), system=system, skills_root=skills_root
        )
        if row_path != path_key:
            continue
        binding_errors: list[str] = []
        if row_id != public_id:
            binding_errors.append("active_manifest_wave_id_path_mismatch")
        if definition_path != system / path_key:
            binding_errors.append("active_manifest_definition_path_mismatch")
        expected_definition_id = REQUIRED_ACTIVE_DEFINITION_IDS.get(public_id)
        if expected_definition_id is not None and definition_wave_id != expected_definition_id:
            binding_errors.append("active_definition_wave_id_mismatch")
        if row.get("definition_sha256") != definition_sha256:
            binding_errors.append("active_manifest_definition_hash_mismatch")
        script_key, script_path = _manifest_confined_path(
            row.get("script"), system=system, skills_root=skills_root
        )
        skill_prefix = path_key[: -len("/wave.json")]
        if script_key is None or script_path is None:
            binding_errors.append("active_manifest_script_not_confined")
        elif not script_key.startswith(skill_prefix + "/"):
            binding_errors.append("active_manifest_script_path_mismatch")
        elif row.get("script_sha256") != sha256_file(script_path):
            binding_errors.append("active_manifest_script_hash_mismatch")
        skill_key, manifest_skill_path = _manifest_confined_path(
            row.get("skill"), system=system, skills_root=skills_root
        )
        expected_skill_key = skill_prefix + "/SKILL.md"
        if skill_key is None or manifest_skill_path is None:
            binding_errors.append("active_manifest_skill_not_confined")
        elif skill_key != expected_skill_key:
            binding_errors.append("active_manifest_skill_path_mismatch")
        elif row.get("skill_sha256") != skill_sha256:
            binding_errors.append("active_manifest_skill_hash_mismatch")
        if binding_errors:
            return (
                "AUTHORED_INACTIVE",
                "invalid_active_manifest_binding",
                sorted(set(binding_errors)),
            )
        return "ACTIVE", "runnable_cohort", []

    # A matching ID without the exact local definition path is not authority.
    # It remains visible as an unregistered candidate and cannot run.
    if any(row.get("wave_id") == public_id for row in rows):
        return (
            "UNREGISTERED_CANDIDATE",
            "active_manifest_definition_path_mismatch",
            ["active_manifest_definition_path_mismatch"],
        )

    declared_paths: set[str] = set()
    for value in data.get("wave_definitions", []) or []:
        key = _manifest_path_key(value)
        if key:
            declared_paths.add(key)
    zip_path = _manifest_path_key(data.get("zip_wave_definition"))
    if zip_path:
        declared_paths.add(zip_path)
    authored_ids = {
        value
        for value in (
            _manifest_wave_id(item)
            for item in data.get("authored_specs_not_active", []) or []
        )
        if value
    }
    if path_key in declared_paths:
        return "AUTHORED_INACTIVE", "active_manifest_definition", []
    if public_id in authored_ids:
        return "AUTHORED_INACTIVE", "authored_specs_not_active", []
    return "UNREGISTERED_CANDIDATE", "unregistered", []


def _candidate_reason(validation: Mapping[str, Any]) -> str:
    errors = [str(value) for value in validation.get("errors", [])]
    if any(value.startswith("invalid_json:") for value in errors):
        return "INVALID_JSON"
    if any(value.startswith("missing_child_skill:") for value in errors):
        return "MISSING_CHILD_SKILL"
    if any(value.startswith("missing_child_wave_definition:") for value in errors):
        return "MISSING_CHILD_WAVE_DEFINITION"
    if errors:
        return "INVALID_WAVE_DEFINITION"
    return "INACTIVE_SPEC_ONLY"


def _active_source_entries(
    *,
    manifest: Mapping[str, Any],
    path_key: str,
    system: Path,
    skills_root: Path,
) -> list[dict[str, str]]:
    """Return exactly the trusted definition/script/SKILL bindings."""

    data = manifest.get("data") or {}
    for row in data.get("runnable_cohort", []) or []:
        if not isinstance(row, dict):
            continue
        definition_key, definition_path = _manifest_confined_file(
            row.get("definition"), system=system, skills_root=skills_root
        )
        if definition_key != path_key or definition_path is None:
            continue
        script_key, script_path = _manifest_confined_path(
            row.get("script"), system=system, skills_root=skills_root
        )
        skill_key, skill_path = _manifest_confined_path(
            row.get("skill"), system=system, skills_root=skills_root
        )
        if script_key is None or script_path is None or skill_key is None or skill_path is None:
            return []
        return [
            {"path": definition_key, "sha256": sha256_file(definition_path)},
            {"path": script_key, "sha256": sha256_file(script_path)},
            {"path": skill_key, "sha256": sha256_file(skill_path)},
        ]
    return []


def _required_active_contract_errors(
    *, rows: list[dict[str, Any]], manifest: Mapping[str, Any]
) -> list[str]:
    """Enforce the fixed v1 direct cohort and declaration coverage."""

    errors: list[str] = []
    physical_ids = {
        row.get("wave_id")
        for row in rows
        if isinstance(row.get("wave_id"), str)
    }
    for wave_id in sorted(REQUIRED_ACTIVE_WAVE_IDS):
        if wave_id not in physical_ids:
            errors.append(f"required_active_definition_missing:{wave_id}")
    for row in rows:
        wave_id = row.get("wave_id")
        expected_definition_id = REQUIRED_ACTIVE_DEFINITION_IDS.get(wave_id)
        if expected_definition_id is not None and row.get("definition_wave_id") != expected_definition_id:
            errors.append(f"required_active_definition_id_mismatch:{wave_id}")
    if not manifest.get("available"):
        errors.append("required_active_manifest_unavailable")
        return sorted(set(errors))
    data = manifest.get("data") or {}
    manifest_ids = {
        row.get("wave_id")
        for row in data.get("runnable_cohort", []) or []
        if isinstance(row, dict) and isinstance(row.get("wave_id"), str)
    }
    if manifest_ids != REQUIRED_ACTIVE_WAVE_IDS:
        errors.append("required_active_manifest_ids_mismatch")
    declared = {
        key
        for key in (_manifest_path_key(item) for item in data.get("wave_definitions", []) or [])
        if key
    }
    active_catalog_paths = {
        row.get("definition")
        for row in rows
        if row.get("classification") == "ACTIVE"
    }
    for wave_id in sorted(REQUIRED_ACTIVE_WAVE_IDS):
        key = f"skills/{wave_id}/wave.json"
        if key not in declared:
            errors.append(f"required_active_manifest_definition_missing:{wave_id}")
        if key not in active_catalog_paths:
            errors.append(f"required_active_catalog_missing:{wave_id}")
    return sorted(set(errors))


def _wave_row(
    path: Path,
    *,
    system: Path,
    skills_root: Path,
    manifest: Mapping[str, Any],
) -> dict[str, Any]:
    path_key = _relative_product_path(path, system)
    skill_dir = path.parent
    public_id = skill_dir.name
    if path_key is None or not _regular_confined(path, skills_root):
        return {
            "wave_id": public_id,
            "definition_wave_id": None,
            "classification": "UNREGISTERED_CANDIDATE",
            "disposition": "UNREGISTERED_CANDIDATE",
            "state": "UNREGISTERED_CANDIDATE",
            "status": "HOLD",
            "manifest_authority": "unsafe_definition_path",
            "definition": path_key,
            "definition_path": path_key,
            "source_path": _relative_product_path(skill_dir, system),
            "definition_sha256": None,
            "raw_definition_sha256": None,
            "source_sha256": None,
            "skill_sha256": None,
            "validation": {
                "validator_available": False,
                "definition_errors": [],
                "tree_errors": [],
                "errors": ["definition_not_confined"],
                "disposition": "REFUSE_WAVE_DEFINITION",
            },
            "validation_findings": ["definition_not_confined"],
            "validation_errors": ["definition_not_confined"],
            "validator_errors": ["definition_not_confined"],
            "source": [],
            "runnable": False,
            "promotion_allowed": False,
            "candidate_state": None,
            "activated": False,
            "parse_error": None,
            "reason_code": "DEFINITION_NOT_CONFINED",
        }
    definition_sha256 = sha256_file(path)
    tree_security = _tree_security_findings(skill_dir, skills_root)
    source_sha256 = None if tree_security else _sha256_tree(skill_dir)
    skill_path = skill_dir / "SKILL.md"
    skill_key = _relative_product_path(skill_path, system)
    skill_sha256 = (
        sha256_file(skill_path)
        if _regular_confined(skill_path, skills_root)
        else None
    )
    definition: dict[str, Any] = {}
    parse_error: str | None = None
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            definition = loaded
        else:
            parse_error = f"definition_not_object:{type(loaded).__name__}"
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        parse_error = f"invalid_json:{type(exc).__name__}"
    validation = _validate_wave_definition(path, skills_root)
    if tree_security:
        validation["security_errors"] = tree_security
        validation["errors"] = tree_security + list(validation.get("errors", []))
        validation["disposition"] = "REFUSE_WAVE_DEFINITION"
    child_security: list[str] = []
    for child in definition.get("children", []) if isinstance(definition, dict) else []:
        if not isinstance(child, dict) or not isinstance(child.get("skill"), str):
            continue
        child_dir = skills_root / child["skill"]
        if child_dir.is_symlink():
            child_security.append(f"SYMLINKED_CHILD_SKILL:{child['skill']}")
        elif child_dir.exists() and not _regular_confined(
            child_dir, skills_root, directory=True
        ):
            child_security.append(f"CHILD_SKILL_NOT_CONFINED:{child['skill']}")
    if child_security:
        validation["security_errors"] = list(validation.get("security_errors", [])) + child_security
        validation["errors"] = list(validation.get("errors", [])) + child_security
        validation["disposition"] = "REFUSE_WAVE_DEFINITION"
    definition_wave_id = definition.get("wave_id") if isinstance(definition.get("wave_id"), str) else None
    classification, authority, membership_errors = _wave_catalog_membership(
        public_id=public_id,
        path_key=path_key,
        definition_path=path,
        definition_wave_id=definition_wave_id,
        definition_sha256=definition_sha256,
        skill_sha256=skill_sha256,
        system=system,
        skills_root=skills_root,
        manifest=manifest,
    )
    if tree_security or child_security:
        classification = "AUTHORED_INACTIVE" if classification == "ACTIVE" else classification
        authority = "unsafe_skill_tree"
    row: dict[str, Any] = {
        "wave_id": public_id,
        "definition_wave_id": definition_wave_id,
        "classification": classification,
        "disposition": classification,
        "state": classification,
        "status": "ACTIVE" if classification == "ACTIVE" else "INACTIVE",
        "manifest_authority": authority,
        "manifest_findings": membership_errors,
        "definition": path_key,
        "definition_path": path_key,
        "source_path": _relative_product_path(skill_dir, system),
        "tree_path": _relative_product_path(skill_dir, system),
        "definition_sha256": definition_sha256,
        "raw_definition_sha256": definition_sha256,
        "source_sha256": source_sha256,
        "tree_sha256": source_sha256,
        "skill": skill_key,
        "skill_sha256": skill_sha256,
        "validation": validation,
        "validation_findings": list(validation.get("errors", [])),
        "validation_errors": list(validation.get("errors", [])),
        "validator_errors": list(validation.get("errors", [])),
        "source": (
            [
                {
                    "path": _relative_product_path(skill_dir, system),
                    "sha256": source_sha256,
                }
            ]
            if source_sha256 is not None
            else []
        ),
        "runnable": False,
        "promotion_allowed": False,
        "candidate_state": definition.get("candidate_state"),
        "activation_observed": definition.get("activated", False),
        "activated": False,
        "parse_error": parse_error,
    }
    runner = _public_wave_module(system)
    if classification == "ACTIVE" and runner is not None and not tree_security and not child_security:
        try:
            inspected = runner.inspect_wave(public_id, system_root=system)
        except Exception as exc:  # pragma: no cover - runner compatibility guard
            inspected = {
                "status": "HOLD",
                "reason_code": f"ACTIVE_INSPECTION_ERROR:{type(exc).__name__}",
                "findings": [],
                "runnable": False,
                "promotion_allowed": False,
            }
        if isinstance(inspected, dict):
            row.update(inspected)
            row["wave_id"] = public_id
            row["definition_wave_id"] = definition_wave_id
            row["classification"] = classification
            row["disposition"] = classification
            row["state"] = classification
            row["manifest_authority"] = authority
            row["definition"] = path_key
            row["definition_path"] = path_key
            row["source_path"] = _relative_product_path(skill_dir, system)
            row["tree_path"] = _relative_product_path(skill_dir, system)
            row["definition_sha256"] = definition_sha256
            row["raw_definition_sha256"] = definition_sha256
            row["source_sha256"] = source_sha256
            row["tree_sha256"] = source_sha256
            row["skill_sha256"] = skill_sha256
            row["skill"] = (
                next(
                    (
                        item.get("skill")
                        for item in (manifest.get("data", {}).get("runnable_cohort", []) or [])
                        if isinstance(item, dict)
                        and item.get("wave_id") == public_id
                    ),
                    None,
                )
            )
            row["source"] = _active_source_entries(
                manifest=manifest,
                path_key=path_key,
                system=system,
                skills_root=skills_root,
            )
            row["validation"] = validation
            row["validation_findings"] = list(validation.get("errors", []))
            row["validation_errors"] = list(validation.get("errors", []))
            row["validator_errors"] = list(validation.get("errors", []))
            row["promotion_allowed"] = False
    else:
        row["reason_code"] = (
            "SYMLINKED_OR_OUTSIDE_SKILL_TREE"
            if tree_security or child_security
            else membership_errors[0]
            if membership_errors
            else _candidate_reason(validation)
        )
        row["findings"] = list(validation.get("errors", []))
        row["runnable"] = False
    if classification != "ACTIVE":
        row["runnable"] = False
        row["promotion_allowed"] = False
    return row


def discover_wave_catalog(
    system: Path | None = None, *, system_root: Path | None = None
) -> dict[str, Any]:
    """Discover every immediate ``skills/*/wave.json`` without activation."""

    system = (system_root or system or roots()[2]).expanduser().resolve(strict=True)
    skills_root = _fixed_skills_root(system)
    manifest = _read_active_wave_manifest(system)
    if skills_root is None:
        return {
            "schema": "constraintbox.public-wave-list.v1",
            "catalog_schema": "constraintbox.public-wave-catalog.v1",
            "catalog_state": "REFUSE",
            "catalog_errors": ["skills_root_not_confined"],
            "required_active_wave_ids": sorted(REQUIRED_ACTIVE_WAVE_IDS),
            "manifest": _sanitize_public_paths(manifest),
            "waves": [],
            "all_waves": [],
            "active": [],
            "authored_inactive": [],
            "unregistered_candidates": [],
            "candidates": [],
            "omitted": [],
            "runnable_cohort": [],
            "inactive": [],
            "claim_ceiling": (
                "Checked-in product bytes and trusted manifest bindings only; "
                "Git custody and external immutability are unproved."
            ),
            "promotion_allowed": False,
        }
    paths: list[Path] = []
    omitted: list[dict[str, Any]] = []
    for path in sorted(skills_root.glob("*/wave.json"), key=lambda value: value.as_posix()):
        lexical = path.relative_to(system).as_posix()
        skill_dir = path.parent
        if path.is_symlink() or not _regular_confined(path, skills_root):
            omitted.append(
                {
                    "wave_id": skill_dir.name,
                    "definition": lexical,
                    "status": "HOLD",
                    "reason_code": "DEFINITION_NOT_CONFINED",
                    "findings": ["DEFINITION_SYMLINKED_OR_OUTSIDE_SKILLS_ROOT"],
                    "runnable": False,
                    "promotion_allowed": False,
                }
            )
            continue
        if skill_dir.is_symlink() or not _regular_confined(skill_dir, skills_root, directory=True):
            omitted.append(
                {
                    "wave_id": skill_dir.name,
                    "definition": lexical,
                    "status": "HOLD",
                    "reason_code": "SKILL_DIR_NOT_CONFINED",
                    "findings": ["SKILL_DIR_SYMLINKED_OR_OUTSIDE_SKILLS_ROOT"],
                    "runnable": False,
                    "promotion_allowed": False,
                }
            )
            continue
        paths.append(path)
    rows = [
        _wave_row(
            path,
            system=system,
            skills_root=skills_root,
            manifest=manifest,
        )
        for path in paths
    ]
    definition_ids: dict[str, list[str]] = {}
    for row in rows:
        definition_id = row.get("definition_wave_id")
        if isinstance(definition_id, str) and definition_id:
            definition_ids.setdefault(definition_id, []).append(row["wave_id"])
    duplicate_definition_ids = sorted(
        definition_id
        for definition_id, public_ids in definition_ids.items()
        if len(public_ids) > 1
    )
    contract_errors = _required_active_contract_errors(
        rows=rows, manifest=manifest
    )
    catalog_errors = sorted(
        set(
            [*manifest.get("errors", []),
             *[f"duplicate_definition_wave_id:{value}" for value in duplicate_definition_ids],
             *contract_errors]
        )
    )
    if catalog_errors:
        for row in rows:
            row["catalog_errors"] = catalog_errors
            row["runnable"] = False
            row["promotion_allowed"] = False
            if row.get("classification") == "ACTIVE":
                row["status"] = "HOLD"
                row["reason_code"] = catalog_errors[0]
                row["findings"] = list(row.get("findings", [])) + catalog_errors
    active = [row for row in rows if row["classification"] == "ACTIVE"]
    authored = [row for row in rows if row["classification"] == "AUTHORED_INACTIVE"]
    candidates = [
        row for row in rows if row["classification"] == "UNREGISTERED_CANDIDATE"
    ]
    existing: dict[str, Any] = {}
    runner = _public_wave_module(system)
    if runner is not None and manifest.get("available") and not catalog_errors:
        try:
            existing = runner.list_waves(system_root=system)
        except Exception:
            existing = {}
    inactive = list(
        existing.get(
            "inactive",
            [
                {
                    "wave_id": row["wave_id"],
                    "status": "INACTIVE",
                    "runnable": False,
                    "reason_code": row.get("reason_code", "INACTIVE_SPEC_ONLY"),
                    "promotion_allowed": False,
                }
                for row in authored
            ],
        )
    )
    inactive_ids = {
        row.get("wave_id")
        for row in inactive
        if isinstance(row, dict) and isinstance(row.get("wave_id"), str)
    }
    for row in [*authored, *candidates]:
        if row["wave_id"] not in inactive_ids:
            inactive.append(row)
            inactive_ids.add(row["wave_id"])
    inactive.sort(key=lambda row: str(row.get("wave_id", "")))
    result = {
        "schema": "constraintbox.public-wave-list.v1",
        "catalog_schema": "constraintbox.public-wave-catalog.v1",
        "catalog_state": "REFUSE" if catalog_errors else "READY",
        "catalog_errors": catalog_errors,
        "required_active_wave_ids": sorted(REQUIRED_ACTIVE_WAVE_IDS),
        "duplicate_definition_wave_ids": duplicate_definition_ids,
        "manifest": manifest,
        "waves": rows,
        "all_waves": rows,
        "active": active,
        "authored_inactive": authored,
        "unregistered_candidates": candidates,
        "candidates": candidates,
        "omitted": omitted,
        "runnable_cohort": [] if catalog_errors else active,
        "inactive": inactive,
        "claim_ceiling": (
            "Checked-in product bytes and trusted manifest bindings only; "
            "Git custody and external immutability are unproved."
        ),
        "promotion_allowed": False,
    }
    return _sanitize_public_paths(result)


def inspect_discovered_wave(
    wave_id: str, system: Path | None = None, *, system_root: Path | None = None
) -> dict[str, Any]:
    catalog = discover_wave_catalog(system, system_root=system_root)
    matches = [
        row
        for row in catalog["waves"]
        if row.get("wave_id") == wave_id or row.get("definition_wave_id") == wave_id
    ]
    if not matches:
        return {
            "schema": "constraintbox.public-wave-inspection.v1",
            "wave_id": wave_id,
            "classification": "UNKNOWN",
            "disposition": "UNKNOWN_WAVE",
            "status": "REFUSE",
            "reason_code": "UNKNOWN_WAVE",
            "runnable": False,
            "promotion_allowed": False,
        }
    result = dict(matches[0])
    result["schema"] = "constraintbox.public-wave-inspection.v1"
    return result


def jax_profile_attestation(system: Path, python: Path | None) -> dict[str, object]:
    if python is None:
        return {"status": "HOLD", "reason": "JAX_INTERPRETER_UNDECLARED"}
    # A venv's executable is commonly a symlink to the base interpreter.
    # Profile identity comes from the declared venv path, not that symlink's
    # target outside the profile.
    profile_root = python.expanduser().absolute().parent.parent
    manifest_path = profile_root / "STACK_MANIFEST.json"
    expected_lock = system / "runtime_profiles/jax_qit/requirements.lock"
    if not manifest_path.is_file() or not expected_lock.is_file():
        return {
            "status": "HOLD",
            "reason": "HOLD_JAX_PROFILE_ATTESTATION_MISSING",
            "manifest": str(manifest_path),
        }
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        return {
            "status": "HOLD",
            "reason": "HOLD_JAX_PROFILE_ATTESTATION_UNREADABLE",
            "detail": f"{type(exc).__name__}:{exc}",
        }
    declared_lock = (manifest.get("requirements") or {}).get("lock_sha256")
    expected_sha = sha256_file(expected_lock)
    valid = (
        manifest.get("schema") == "constraintbox.jax-qit-stack-manifest.v1"
        and manifest.get("profile") == "jax_qit"
        and manifest.get("status") == "VERIFIED_LOCAL"
        and declared_lock == expected_sha
    )
    return {
        "status": "PASS" if valid else "HOLD",
        "reason": None if valid else "HOLD_JAX_PROFILE_ATTESTATION_DRIFT",
        "manifest": str(manifest_path),
        "manifest_sha256": sha256_file(manifest_path),
        "expected_lock_sha256": expected_sha,
        "declared_lock_sha256": declared_lock,
        "runtime_root": str(profile_root),
    }


def supported_jax_version(value: object) -> bool:
    """The current numerical profile is tested against the JAX 0.10 series."""

    try:
        major, minor, *_ = (int(part) for part in str(value).split("."))
    except (TypeError, ValueError):
        return False
    return (major, minor) == (0, 10)


def doctor(box: Path, system: Path, light_python: Path, jax_python: Path | None) -> int:
    light_jax_observation = probe_module(light_python, "jax")
    light_jax = {
        "status": "PASS" if light_jax_observation["status"] == "HOLD" else "REFUSE_JAX_IN_LIGHT",
        "expected": "jax import fails",
        "observation": light_jax_observation,
    }
    jax = probe_module(jax_python, "jax") if jax_python is not None else {"status": "HOLD", "reason": "JAX_INTERPRETER_UNDECLARED"}
    if jax.get("status") == "PASS" and not supported_jax_version(jax.get("version")):
        jax["status"] = "HOLD"
        jax["reason"] = "HOLD_JAX_VERSION_PROFILE_MISMATCH"
        jax["required_profile"] = ">=0.10.0,<0.11.0"
    profile = jax_profile_attestation(system, jax_python)
    zip_protocol = box / "zip_agent" / "src" / "constraintbox_zip_agent" / "protocol.py"
    if not zip_protocol.is_file():
        zip_protocol = system / "runtime" / "zip_agent_src" / "constraintbox_zip_agent" / "protocol.py"
    required = [
        box / "scripts" / "contained_light" / "seed_check.py",
        zip_protocol,
        system / "skills" / "MANIFEST.txt",
        system / "context" / "current" / "OWNER_OBJECT.md",
        system / "state" / "GENESIS.json",
    ]
    missing = [str(path) for path in required if not path.is_file()]
    status = (
        "PASS"
        if not missing
        and light_jax["status"] == "PASS"
        and jax["status"] == "PASS"
        and profile["status"] == "PASS"
        else "HOLD"
    )
    body = {
        "schema": "constraintbox.integrated-doctor.v1",
        "status": status,
        "box_root": str(box),
        "system_root": str(system),
        "light_python": str(light_python),
        "light_jax_negative": light_jax,
        "jax_runtime": jax,
        "jax_profile": profile,
        "missing_paths": missing,
        "boundaries": {
            "one_system": True,
            "interpreter_count": 2 if jax_python is not None else 1,
            "light_must_not_import_jax": True,
            "model_roster_in_kernel": False,
        },
        "claim_ceiling": "local path/import boundary check only; not admission or portability",
        "promotion_allowed": False,
    }
    print(json.dumps(body, indent=2, sort_keys=True))
    return 0 if status == "PASS" else 2


def main(argv: list[str] | None = None) -> int:
    _, box, system = roots()
    caller_cwd = Path.cwd()

    def user_path(path: Path) -> Path:
        return path if path.is_absolute() else (caller_cwd / path).absolute()

    parser = argparse.ArgumentParser(prog="cb")
    parser.add_argument("--light-python", default=os.environ.get("CB_LIGHT_PYTHON"))
    parser.add_argument("--jax-python", default=os.environ.get("CB_JAX_PYTHON"))
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("bootstrap-light")
    jax_profile = sub.add_parser(
        "jax-profile",
        help="plan, install, or probe the separate project-neutral JAX/QIT runtime",
    )
    jax_profile.add_argument("args", nargs=argparse.REMAINDER)
    sub.add_parser("doctor")
    seed = sub.add_parser("light-seed")
    seed.add_argument("--out", type=Path)
    zip_cmd = sub.add_parser("zip")
    zip_cmd.add_argument("args", nargs=argparse.REMAINDER)
    provider_zip = sub.add_parser(
        "provider-zip",
        help="build or verify one packet-bound provider child ZIP tree",
    )
    provider_zip.add_argument("args", nargs=argparse.REMAINDER)
    premortem_candidate = sub.add_parser(
        "premortem-candidate",
        help="run the inactive ZIP-native premortem candidate under a CB lease",
    )
    premortem_candidate.add_argument("--config", required=True, type=Path)
    premortem_candidate.add_argument("--target", required=True, type=Path)
    premortem_candidate.add_argument("--skill", required=True, type=Path)
    premortem_candidate.add_argument("--mmm", action="append", default=[])
    premortem_candidate.add_argument("--out", required=True, type=Path)
    premortem_candidate.add_argument("--cancel", action="store_true")
    hook = sub.add_parser("hook")
    hook.add_argument("host", nargs="?")
    wave = sub.add_parser("jax-wave")
    wave.add_argument("--output-dir", required=True, type=Path)
    public_wave = sub.add_parser("wave", help="list, inspect, or run a contained wave")
    public_wave.add_argument("action", choices=("list", "inspect", "run"))
    public_wave.add_argument("wave_id", nargs="?")
    public_wave.add_argument("--output-dir", type=Path)
    public_wave.add_argument("--timeout", type=float, default=120.0)
    public_wave.add_argument("--cancel-file", type=Path)
    public_wave.add_argument("--run-id")
    campaign = sub.add_parser(
        "campaign",
        help="run the model-free deterministic cumulative wave schedule",
    )
    campaign.add_argument("--profile", choices=("light", "heavy"), default="light")
    campaign.add_argument("--output-dir", type=Path)
    campaign.add_argument("--timeout", type=float, default=120.0)
    campaign.add_argument("--cancel-file", type=Path)
    campaign.add_argument("--run-id")
    structured = sub.add_parser("structured-probe")
    structured.add_argument("--engine", choices=("exact", "dual"), default="exact")
    structured.add_argument("--output", required=True, type=Path)
    path_mass = sub.add_parser(
        "path-mass",
        help="run or replay the bounded Mini-Lev constraint-path mass probe",
    )
    path_mass.add_argument("--output", required=True, type=Path)
    path_mass.add_argument("--replay", type=Path)
    path_mass.add_argument("--require-jax", action="store_true")
    context = sub.add_parser("context")
    context.add_argument(
        "--refresh-source",
        type=Path,
        help="append new exact message events from one declared Codex rollout",
    )
    context.add_argument("--dry-run", action="store_true")
    verify = sub.add_parser("verify")
    verify.add_argument("--output", type=Path)
    bundle = sub.add_parser("bundle")
    bundle.add_argument("--output", required=True, type=Path)
    args = parser.parse_args(argv)

    if args.command == "bootstrap-light":
        return bootstrap_light(box)
    if args.command == "jax-profile":
        return run(
            [
                sys.executable,
                str(system / "runtime_profiles/jax_qit/bootstrap_jax_qit.py"),
                *args.args,
            ],
            cwd=Path.cwd(),
        )

    # Listing and inspection are read-only catalog operations.  Keep them
    # available on a fresh extraction even when the contained Light runtime
    # has not been bootstrapped yet; the run action still follows the pinned
    # runner path below.
    if args.command == "wave" and args.action in {"list", "inspect"}:
        if args.action == "list":
            print(json.dumps(discover_wave_catalog(system), indent=2, sort_keys=True))
            return 0
        if not args.wave_id:
            parser.error("wave inspect/run requires wave_id")
        inspection = inspect_discovered_wave(args.wave_id, system)
        print(json.dumps(inspection, indent=2, sort_keys=True))
        return 0 if inspection.get("runnable") else 2

    light = declared_python(args.light_python, box / ".venv" / "bin" / "python")
    jax = None
    if args.jax_python:
        jax = declared_python(args.jax_python, Path(args.jax_python))
    else:
        discovered_jax = default_jax_python()
        if discovered_jax is not None:
            jax = declared_python(None, discovered_jax)
    env = runtime_env(box, system, light)

    if args.command == "doctor":
        return doctor(box, system, light, jax)
    if args.command == "light-seed":
        command = [str(light), str(box / "scripts/contained_light/seed_check.py"), "--root", str(box)]
        if args.out is not None:
            command.extend(["--out", str(user_path(args.out))])
        return run(command, cwd=box, env=env)
    if args.command == "zip":
        return run(
            [str(light), "-m", "constraintbox_zip_agent", *args.args],
            cwd=Path.cwd(),
            env=env,
        )
    if args.command == "provider-zip":
        return run_provider_zip(
            list(args.args),
            box=box,
            system=system,
            light=light,
            env=env,
        )
    if args.command == "premortem-candidate":
        controller = system / "runtime" / "controller_src" / "constraintbox"
        if not controller.is_dir():
            controller = box / "src" / "constraintbox"
        hook_source = controller / "hook_adapter.py"
        if not hook_source.is_file():
            raise SystemExit("HOLD_PROVIDER_CONTROLLER_UNBOUND")
        spec = importlib.util.spec_from_file_location(
            "constraintbox_premortem_dispatch_lease", hook_source
        )
        if spec is None or spec.loader is None:
            raise SystemExit("HOLD_PROVIDER_DISPATCH_LEASE_UNAVAILABLE")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        target = user_path(args.target)
        config = user_path(args.config)
        identity = "premortem-" + hashlib.sha256(
            (sha256_file(target) + sha256_file(config)).encode("ascii")
        ).hexdigest()[:24]
        command = [
            str(light),
            str(system / "skills/cb-premortem-wave/scripts/run_premortem_zip_wave.py"),
            "--config",
            str(config),
            "--target",
            str(target),
            "--skill",
            str(user_path(args.skill)),
            "--out",
            str(user_path(args.out)),
        ]
        for value in args.mmm:
            command.extend(["--mmm", value])
        if args.cancel:
            command.append("--cancel")
        with module.issue_dispatch_lease(identity) as (overlay, _metadata):
            child_env = dict(env)
            child_env.update(overlay)
            return run(command, cwd=box, env=child_env)
    if args.command == "hook":
        command = [str(light), str(box / "src" / "constraintbox" / "hook_adapter.py")]
        if (system / "runtime" / "controller_src" / "constraintbox" / "hook_adapter.py").is_file():
            command = [str(light), "-m", "constraintbox.hook_adapter"]
        if args.host:
            command.append(args.host)
        return run(command, cwd=Path.cwd(), env=env)
    if args.command == "jax-wave":
        if jax is None:
            raise SystemExit("HOLD_JAX_INTERPRETER_UNDECLARED")
        return run(
            [
                str(light),
                str(system / "scripts/run_light_jax_wave_bridge.py"),
                "--box-root",
                str(box),
                "--light-python",
                str(light),
                "--jax-python",
                str(jax),
                "--skills-root",
                str(system / "skills"),
                "--mmm-root",
                str(system / "mmms/primary"),
                "--output-dir",
                str(user_path(args.output_dir)),
            ],
            cwd=box,
            env=env,
        )
    if args.command == "wave":
        if args.action in {"inspect", "run"} and not args.wave_id:
            parser.error("wave inspect/run requires wave_id")
        command = [
            str(light),
            str(system / "scripts/run_wave.py"),
            args.action,
        ]
        if args.wave_id:
            command.append(args.wave_id)
        command.extend(["--system-root", str(system), "--python", str(light)])
        if args.output_dir is not None:
            wave_output = (
                args.output_dir
                if args.output_dir.is_absolute()
                else system / args.output_dir
            )
            command.extend(["--output-dir", str(wave_output)])
        if args.cancel_file is not None:
            wave_cancel = (
                args.cancel_file
                if args.cancel_file.is_absolute()
                else system / args.cancel_file
            )
            command.extend(["--cancel-file", str(wave_cancel)])
        if args.run_id:
            command.extend(["--run-id", args.run_id])
        command.extend(["--timeout", str(args.timeout)])
        return run(command, cwd=box, env=env)
    if args.command == "campaign":
        command = [
            str(light),
            str(system / "scripts/run_cumulative_waves.py"),
            "--system-root",
            str(system),
            "--profile",
            args.profile,
            "--python",
            str(light),
            "--timeout",
            str(args.timeout),
        ]
        if args.output_dir is not None:
            campaign_output = (
                args.output_dir
                if args.output_dir.is_absolute()
                else system / args.output_dir
            )
            command.extend(["--output-dir", str(campaign_output)])
        if args.cancel_file is not None:
            campaign_cancel = (
                args.cancel_file
                if args.cancel_file.is_absolute()
                else system / args.cancel_file
            )
            command.extend(["--cancel-file", str(campaign_cancel)])
        if args.run_id:
            command.extend(["--run-id", args.run_id])
        return run(command, cwd=box, env=env)
    if args.command == "structured-probe":
        engine_python = light if args.engine == "exact" else jax
        if engine_python is None:
            raise SystemExit("HOLD_JAX_INTERPRETER_UNDECLARED")
        return run(
            [
                str(engine_python),
                str(system / "scripts/structured_open_bind_probe.py"),
                "--input",
                str(system / "fixtures/structured_open_bind_v1.json"),
                "--output",
                str(user_path(args.output)),
                "--engine",
                args.engine,
            ],
            cwd=box,
            env=env,
        )
    if args.command == "path-mass":
        if args.require_jax and jax is None:
            raise SystemExit("HOLD_JAX_INTERPRETER_UNDECLARED")
        command = [
            str(light),
            str(system / "scripts/run_constraint_path_mass.py"),
            "--out",
            str(user_path(args.output)),
            "--fixture",
            str(box / "fixtures/minilev/proposal_reference_policy_v1.json"),
        ]
        if jax is not None:
            command.extend(["--jax-python", str(jax)])
        if args.require_jax:
            command.append("--require-jax")
        if args.replay is not None:
            command.extend(["--replay", str(user_path(args.replay))])
        return run(command, cwd=box, env=env)
    if args.command == "context":
        if args.refresh_source is not None:
            command = [
                str(light),
                str(system / "scripts/refresh_context_corpus.py"),
                "--corpus",
                str(system / "context/full/prompt_plan_progress_corpus.jsonl"),
                "--manifest",
                str(system / "context/full/CORPUS_MANIFEST.json"),
                "--source",
                str(user_path(args.refresh_source)),
                "--refresh-ledger",
                str(system / "context/full/CORPUS_REFRESH_LEDGER.jsonl"),
            ]
            if args.dry_run:
                command.append("--dry-run")
            return run(command, cwd=box, env=env)
        print(
            json.dumps(
                {
                    "schema": "constraintbox.integrated-context-locator.v1",
                    "owner_object": str(system / "context/current/OWNER_OBJECT.md"),
                    "current_plan": str(system / "context/current/CURRENT_PLAN.md"),
                    "failure_memory": str(system / "context/current/FAILURE_MEMORY.md"),
                    "full_corpus": str(system / "context/full/prompt_plan_progress_corpus.jsonl"),
                    "genesis": str(system / "state/GENESIS.json"),
                    "promotion_allowed": False,
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 0
    if args.command == "verify":
        command = [
            str(light),
            str(system / "scripts/verify_integrated_system.py"),
            "--box-root",
            str(box),
            "--light-python",
            str(light),
        ]
        if jax is not None:
            command.extend(["--jax-python", str(jax)])
        if args.output is not None:
            command.extend(["--output", str(user_path(args.output))])
        return run(command, cwd=box, env=env)
    if args.command == "bundle":
        return run(
            [
                str(light),
                str(system / "scripts/build_system_bundle.py"),
                "--box-root",
                str(box),
                "--output",
                str(user_path(args.output)),
            ],
            cwd=box,
            env=env,
        )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
