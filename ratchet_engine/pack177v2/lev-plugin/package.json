{
  "name": "@lev-os/ratchet-bridge",
  "version": "0.2.0",
  "description": "Authorized local fuel-bearing mathematical Ratchet execution and receipt bridge",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge.ts",
    "./commands/*": "./src/handlers/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lev-os/event-bus": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "leviathan": {
    "type": "plugin",
    "namespace": "ratchet",
    "description": "Schedules and receipts local Ratchet mathematics without selecting candidates or verdicts",
    "capabilities": [
      "local_math_execution",
      "receipt_emission",
      "lineage_projection"
    ],
    "ships-with": false,
    "activation": {
      "events": [
        "onCommand:ratchet:*"
      ],
      "lazy": true
    },
    "contributes": {
      "commands": [
        {
          "name": "ratchet:run-source-balanced",
          "description": "Execute the source-balanced census and compile a fair residual fuel queue",
          "handler": "./src/handlers/run-source-balanced.ts"
        }
      ]
    }
  },
  "license": "MIT"
}
