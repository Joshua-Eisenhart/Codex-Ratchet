  "positive": {
    "test_1_parseval_simple": {
      "name": "finite_sequence_parseval",
      "description": "Discrete Fourier transform preserves L\u00b2 norm: sum|f[n]|\u00b2 = (1/N)\u00b7sum|F[k]|\u00b2",
      "f": [
        1.0,
        0.0,
        1.0,
        0.0
      ],
      "F_magnitude": [
        2.0,
        0.0,
        2.0,
        0.0
      ],
      "||f||\u00b2": 2.0,
      "||F||\u00b2": 8.0,
      "N": 4,
      "||F||\u00b2/N": 2.0,
      "ratio_||F||\u00b2_to_N||f||\u00b2": 1.0,
      "passes": "True"
    },
    "test_2_gaussian_plancherel": {
      "name": "gaussian_signal_plancherel",
      "description": "Gaussian f(x) = exp(-x\u00b2/2) has Fourier transform also Gaussian",
      "||f||\u00b2_symbolic": "pi",
      "||F||\u00b2_symbolic": "2*pi**(3/2)",
      "plancherel_ratio": "1/sqrt(pi)",
      "passes": false
    },
    "test_3_rectangular_pulse": {
      "name": "rectangular_pulse_plancherel",
      "description": "Rectangular pulse rect(x) transforms to sinc(f), preserving L\u00b2",
      "pulse_length": 5,
      "window_size": 16,
      "||pulse||\u00b2": 5.0,
      "||F_pulse||\u00b2": 80.00000000000001,
      "||F_pulse||\u00b2/N": 5.000000000000001,
      "passes": "True"
    }
  },
  "negative": {
    "test_1_unsat_norms_differ": {
      "name": "unsat_norms_differ",
      "description": "cvc5 UNSAT: cannot have ||f||\u00b2 \u2260 ||F\u0302||\u00b2",
      "expected_unsat": true,
      "error": "type object 'Kind' has no attribute 'MINUS'",
      "passes": false
    },
    "test_2_unsat_one_norm_zero": {
      "name": "unsat_one_norm_zero",
      "description": "cvc5 UNSAT: cannot have ||f||\u00b2 = 0 but ||F\u0302||\u00b2 > 0",
      "expected_unsat": true,
      "is_unsat": true,
      "passes": true
    },
    "test_3_unsat_energy_conservation": {
      "name": "unsat_energy_conservation",
      "description": "cvc5 UNSAT: Fourier transform cannot create energy from zero",
      "expected_unsat": true,
      "is_unsat": true,
      "passes": true
    }
  },
  "boundary": {
    "test_1_boundary_zero": {
      "name": "boundary_zero_function",
      "description": "Zero function has ||f||\u00b2 = ||F\u0302||\u00b2 = 0",
      "||zero||\u00b2": 0.0,
      "||FFT(zero)||\u00b2": 0.0,
      "passes": "True"
    },
    "test_2_boundary_delta": {
      "name": "boundary_delta_impulse",
      "description": "Delta impulse \u03b4[n] has constant Fourier transform with full energy",
      "||delta||\u00b2": 1.0,
      "||FFT(delta)||\u00b2": 8.0,
      "||FFT(delta)||\u00b2/N": 1.0,
      "passes": "True"
    },
    "test_3_boundary_cosine": {
      "name": "boundary_even_cosine",
      "description": "Even real function (cosine) has real-valued DFT",
      "cosine_frequency": 2,
      "window_size": 16,
      "||cosine||\u00b2": 7.999999999999997,
      "||F_cosine||\u00b2": 127.99999999999994,
      "||F_cosine||\u00b2/N": 7.9999999999999964,
      "F_is_real_valued": true,
      "passes": "True"
    }
  },
