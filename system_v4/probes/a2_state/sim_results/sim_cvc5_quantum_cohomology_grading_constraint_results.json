      "deg_a": 2,
      "deg_b": 3,
      "c1_beta": 0,
      "deg_product": 5,
      "pass": true,
      "reason": "|a\u222ab| = 2 + 3 - 0 = 5"
    },
    "test_2_cy_quantum_classical": {
      "name": "calabi_yau_quantum_equals_classical",
