    "test_2_self_dual_boundary": {
      "name": "self_dual_boundary",
      "description": "Self-dual object (dual equals itself) is admissible",
      "setup": {
        "object_id": 1,
        "dual_id": 1,
        "is_self_dual": true
      },
      "solver_result": "SAT: sat",
      "satisfiable": true
    },
