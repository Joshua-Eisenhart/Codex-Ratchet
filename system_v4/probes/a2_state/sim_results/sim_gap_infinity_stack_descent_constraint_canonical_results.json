  "positive": {
    "test_positive_cocycle_n4_trivial": {
      "modulus": 4,
      "g_12": 1,
      "g_23": 1,
      "g_13": 1,
      "cocycle_product": "1 + 1 = 1 (mod 4)",
      "is_sat": false,
      "expected": true
    },
    "test_positive_cocycle_n5_nontrivial": {
      "modulus": 5,
      "g_12": 2,
      "g_23": 3,
      "g_13": 0,
      "cocycle_product": "2 + 3 = 0 + 1*5",
      "is_sat": true,
      "expected": true
    },
    "test_positive_cocycle_chain_three": {
      "modulus": 7,
      "g_12": 2,
      "g_23": 3,
      "g_34": 2,
      "is_sat": true,
      "expected": true
    }
  },
  "negative": {
    "test_negative_cocycle_contradiction": {
      "modulus": 5,
      "g_12": 2,
      "g_23": 3,
      "g_13": 0,
      "constraint": "g_12 + g_23 = g_13 (mod n) AND g_12 + g_23 != g_13 (mod n)",
      "is_sat": false,
      "expected": false
    },
    "test_negative_cocycle_incompatible_sum": {
      "modulus": 4,
      "g_12": 1,
      "g_23": 1,
      "g_13": 3,
      "constraint": "1 + 1 = 3 (mod 4)",
      "is_sat": false,
      "expected": false
    },
    "test_negative_cocycle_chain_conflict": {
      "modulus": 6,
      "constraint": "g_13 + g_34 = g_14 AND g_13 + g_34 = 4",
      "is_sat": false,
      "expected": false
    }
  },
  "boundary": {
    "test_boundary_trivial_cocycle_n2": {
      "modulus": 2,
