  "positive": {
    "test_purity_h1": {
      "constraint": "Purity: |Frob eigenvalue on H^1| = q^{1/2}",
      "variety": "elliptic curve over F_5",
      "satisfiable": "True",
      "target_norm_sq": 5
    },
    "test_hasse_elliptic": {
      "variety": "elliptic curve over F_5",
      "alpha_times_alpha_conj": "5",
      "equals_p": true,
      "expected": 5
    },
    "test_functional_eq_p1": {
      "variety": "P^1",
      "functional_form": "Z(1/(q*T)) = q*T^2*Z(T)",
      "difference": "T**2*(-q + q**1.0)/((T - 1)*(T*q - 1))",
      "holds": true
    }
  },
  "negative": {
    "test_purity_violation_unsat": {
      "constraint": "UNSAT when |Frob eigenvalue|^2 \u2260 q^i",
