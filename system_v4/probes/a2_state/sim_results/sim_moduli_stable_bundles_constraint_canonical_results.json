  "positive": {
    "hermitian_einstein_constant": {
      "test": "\u03bb = (deg(E) / rank(E)) \u00b7 (vol(X) / dim(X))",
      "deg_E": 4,
      "rank_E": 2,
      "vol_X": 1,
      "dim_X": 2,
      "lambda": 1.0,
      "expected": 1.0,
      "passed": true
    },
    "stable_admits_he_metric": {
      "test": "deg=4, rank=2; stable bundle \u2192 Hermitian-Einstein metric exists",
      "satisfiable": true,
      "expected": true,
      "passed": true
    }
  },
  "negative": {
    "he_metric_necessary": {
      "test": "Stable bundle \u2227 \u039b_\u03c9 F_A \u2260 \u03bb\u00b7id \u2192 UNSAT (DUY)",
      "satisfiable": false,
      "expected": false,
      "passed": true
    },
    "negative_degree_instability": {
      "test": "deg(E) < 0 \u2192 \u03bc(E) < 0; Hermitian-Einstein metric unlikely",
      "deg_E": -2.0,
      "rank_E": 2,
      "mu_E": -1.0,
      "slope_negative": "True",
      "reason": "Negative degree bundles often lack Hermitian-Einstein metrics",
      "passed": "True"
    }
  },
  "boundary": {
    "trivial_bundle_flat_metric": {
      "test": "Trivial bundle (deg=0, rank=1) admits flat Hermitian-Einstein metric",
      "satisfiable": true,
