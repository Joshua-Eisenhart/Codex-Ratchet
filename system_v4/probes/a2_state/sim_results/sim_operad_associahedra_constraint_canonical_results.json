  "positive": {
    "associahedron_dimension_formula": {
      "test": "Stasheff associahedron K_n has dimension n-2",
      "formula": "dim(K_n) = n-2 for n \u2265 2",
      "computed_examples": [
        {
          "n": 2,
          "computed_dim": 0,
          "correct": true
        },
        {
          "n": 3,
          "computed_dim": 1,
          "correct": true
        },
        {
          "n": 4,
          "computed_dim": 2,
          "correct": true
        },
        {
          "n": 5,
          "computed_dim": 3,
          "correct": true
        }
      ],
      "all_valid": true
    },
    "operad_composition_rank": {
      "test": "Composition of 2-ary op with 2-ary and 3-ary ops yields 5-ary op",
      "formula": "output_arity = \u03a3 input_arities",
      "satisfiable": true,
      "example": "2-ary \u2218 (2-ary, 3-ary) \u2192 5-ary"
    },
    "associahedron_vertices_catalan": {
      "test": "|vertices(K_n)| = Cat_n (Catalan count)",
      "catalan_sequence": [
        {
          "n": 1,
          "Cat_n": 1,
          "vertices_in_K_n": 1
        },
        {
          "n": 2,
          "Cat_n": 2,
          "vertices_in_K_n": 2
        },
        {
          "n": 3,
          "Cat_n": 5,
          "vertices_in_K_n": 5
        },
        {
          "n": 4,
          "Cat_n": 14,
          "vertices_in_K_n": 14
        }
      ],
      "interpretation": "Each vertex is a way to parenthesize n+1 factors"
    },
    "operad_action_associahedra": {
      "test": "n-ary ops in P(n) act consistently on K_n vertices",
      "arity": 3,
      "consistent": true,
      "constraint": "P(n) rank compatible with K_n embedding"
    },
    "may_associative_operad": {
      "test": "May's A_\u221e operad: A_\u221e(4) = K_4",
      "associahedron": "K_4",
      "dimension": 2,
      "vertices": 14,
      "interpretation": "Higher associativity cells form K_n structure"
    }
  },
  "negative": {
    "composition_rank_violation_unsat": {
      "test": "Claiming 2-ary \u2218 (3-ary, 4-ary) = 8-ary (not 7-ary) \u2192 UNSAT",
      "unsat": true,
      "correct_arity": 7,
      "claimed_arity": 8
    },
    "k_n_dimension_violation": {
      "test": "Claiming K_4 has dimension 3 (not 2) \u2192 UNSAT",
      "unsat": true,
      "correct_dim": 2,
      "claimed_dim": 3
    },
    "operadic_associativity_violation": {
      "test": "(a \u2218 b) \u2218 c \u2260 a \u2218 (b \u2218 c) \u2192 UNSAT (operads are associative)",
      "unsat": true,
      "interpretation": "Operadic composition enforces associativity"
    },
    "catalan_vertices_violation": {
      "test": "K_3 has 5 vertices (Cat_3), not 4 \u2192 UNSAT",
      "unsat": true,
      "correct_vertices": 5,
      "claimed_vertices": 4
    }
  },
  "boundary": {
    "boundary_small_associahedra": {
      "test": "Small associahedra: K_2=point (dim 0), K_3=interval (dim 1)",
      "cases": [
        {
          "n": 2,
          "K_n": "K_2",
          "dim": 0
        },
        {
          "n": 3,
          "K_n": "K_3",
          "dim": 1
        }
      ],
      "formula_applies": true
    },
    "boundary_unary_operad": {
      "test": "P(1) = {identity}, no true composition structure",
      "p_1_cardinality": 1,
      "satisfiable": true,
      "interpretation": "1-ary operations are just identity"
    },
    "boundary_large_associahedra": {
      "test": "K_n dimension scales linearly: dim(K_n) = n-2 for any n",
      "large_examples": [
        {
          "n": 10,
          "K_n_dim": 8
        },
        {
          "n": 20,
          "K_n_dim": 18
        },
        {
          "n": 100,
          "K_n_dim": 98
        }
      ],
      "growth": "linear in n"
    },
    "boundary_nested_operad_composition": {
      "test": "(P \u2218 Q)(2) where Q = (3-ary, 2-ary) \u2192 5-ary result",
      "p_arity": 2,
      "q_arities": [
        3,
        2
      ],
      "result_arity": 5,
      "satisfiable": true
    }
  },
  "classification": "canonical"
}