  "positive": {
    "z3_positive_w2_zero_spin_exists": {
      "test": "z3 satisfies: w_2=0 \u2192 spin structure exists",
      "w2_vanishes": true,
      "spin_structure_exists": "True",
      "satisfiable": true,
      "passed": true,
      "method": "z3 first-order logic implication"
    },
    "sympy_positive_sphere_is_spin": {
      "test": "Sympy: S^n admits spin structure for all n",
      "examples": [
        1,
        2,
        3,
        4,
        5
      ],
      "all_spin": true,
      "passed": true,
      "interpretation": "spheres have w_2 = 0",
      "method": "sympy topology enumeration"
    },
    "numpy_positive_manifold_w2_spin": {
      "test": "Numerical: w_2 and spin structure for standard manifolds",
      "manifolds": {
        "S^2": {
          "w2": 0,
          "spin": true
        },
        "T^2": {
          "w2": 0,
          "spin": true
        },
        "S^1 x S^1": {
          "w2": 0,
          "spin": true
        },
        "CP^1": {
          "w2": 0,
          "spin": true
        },
        "S^3": {
          "w2": 0,
          "spin": true
        }
      },
      "all_spin": true,
      "passed": true,
      "interpretation": "all tested manifolds have w_2=0 \u2192 spin",
      "method": "numpy topology table lookup"
    }
  },
