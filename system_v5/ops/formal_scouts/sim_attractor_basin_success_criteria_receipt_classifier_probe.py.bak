    "fixture://false_independence_same_source_metric": {
        "schema": "FORMAL_SCOUT_RESULT_v1_SYNTHETIC_FIXTURE",
        "name": "false_independence_same_source_metric_fixture",
        "classification": "formal_scout",
        "promotion_allowed": False,
        "claim_ceiling": (
