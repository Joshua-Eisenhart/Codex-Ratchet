{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ratchet.local/schemas/wizard-v4-2-worker-receipt.schema.json",
  "title": "Wizard v4.2 worker receipt",
  "type": "object",
  "required": [
    "schema",
    "wizard_version",
    "route",
    "parent_id",
    "pool",
    "launch_surface",
    "terminal_status",
    "counts_toward_topology"
  ],
  "properties": {
    "schema": {
      "const": "wizard-v4.2-worker-receipt"
    },
    "wizard_version": {
      "const": "v4.2"
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "child_id": {
      "type": "string",
      "minLength": 1
    },
    "pool": {
      "enum": [
        "codex-native",
        "claude-bridge",
        "gemini",
        "tmux",
        "tool"
      ]
    },
    "launch_surface": {
      "type": "string",
      "minLength": 1
    },
    "terminal_status": {
      "enum": [
        "completed",
        "failed",
        "timed_out",
        "blocked",
        "abandoned",
        "not_launched",
        "superseded"
      ]
    },
    "artifact_path": {
      "type": "string"
    },
    "accepted_conclusion": {
      "type": "string"
    },
    "counts_toward_topology": {
      "type": "boolean"
    },
    "external_worker": {
      "type": "boolean"
    },
    "controller_marker": {
      "type": "boolean"
    },
    "controller_marker_justification": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "proposed_queue_entries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model": {
      "type": "string"
    },
    "cost_usd": {
      "type": [
        "number",
        "string"
      ]
    },
    "prompt_hash": {
      "type": "string"
    },
    "route_local_mini_mmm_path": {
      "type": "string"
    },
    "task_card": {
      "type": "object"
    },
    "voice_method_check": {
      "type": "string"
    },
    "closeout_check": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "parent_receipt_id": {
      "type": "string"
    },
    "saliency_preload_before_rules": {
      "type": "boolean"
    },
    "slices_loaded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "compact_mmm_loaded": {
      "type": "boolean"
    },
    "full_mmm_loaded": {
      "type": "boolean"
    },
    "required_mini_mmms_loaded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "optional_mini_mmms_loaded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mini_mmm_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 8
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "counts_toward_topology": {
            "const": true
          }
        },
        "required": [
          "counts_toward_topology"
        ]
      },
      "then": {
        "required": [
          "artifact_path",
          "accepted_conclusion",
          "saliency_preload_before_rules",
          "slices_loaded"
        ],
        "properties": {
          "terminal_status": {
            "const": "completed"
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "accepted_conclusion": {
            "type": "string",
            "minLength": 1
          },
          "saliency_preload_before_rules": {
            "const": true
          },
          "slices_loaded": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pool": {
            "enum": [
              "claude-bridge",
              "gemini",
              "tmux"
            ]
          }
        },
        "required": [
          "pool"
        ]
      },
      "then": {
        "properties": {
          "external_worker": {
            "const": true
          }
        },
        "required": [
          "external_worker"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pool": {
            "const": "codex-native"
          },
          "counts_toward_topology": {
            "const": true
          },
          "controller_marker": {
            "const": true
          }
        },
        "required": [
          "pool",
          "counts_toward_topology",
          "controller_marker"
        ]
      },
      "then": {
        "required": [
          "controller_marker_justification"
        ],
        "properties": {
          "controller_marker_justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "not": {
          "required": [
            "child_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "pool": {
            "const": "codex-native"
          },
          "counts_toward_topology": {
            "const": true
          }
        },
        "required": [
          "pool",
          "counts_toward_topology"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "child_id"
            ]
          },
          {
            "properties": {
              "controller_marker": {
                "const": true
              }
            },
            "required": [
              "controller_marker"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
