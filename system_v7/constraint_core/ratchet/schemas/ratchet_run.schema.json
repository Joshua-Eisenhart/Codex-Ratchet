{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ratchet/schemas/ratchet_run.schema.json",
  "title": "Working DIG-GATE-RECEIPT Ratchet run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "root_primitive",
    "process_law",
    "source_packet",
    "budget",
    "gates",
    "summary",
    "open_dig_queue",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "ratchet-search-run/0.4"},
    "run_id": {"type": "string", "minLength": 1},
    "root_primitive": {"const": "constrained_distinguishability"},
    "process_law": {"const": "EXPLORE_WIDE__GATE_STRICT__RECEIPT_ALWAYS__DIG_CONTINUES"},
    "source_packet": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "required": ["gate_limit", "candidate_limit_per_gate", "gradient_hypothesis_limit_per_gate", "global_completeness_claimed"],
      "properties": {
        "gate_limit": {"type": "integer", "minimum": 1},
        "candidate_limit_per_gate": {"type": "integer", "minimum": 2},
        "gradient_hypothesis_limit_per_gate": {"type": "integer", "minimum": 1},
        "global_completeness_claimed": {"const": false}
      },
      "additionalProperties": true
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "question", "finite_observation_count", "exploration", "gate", "receipt"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "finite_observation_count": {"type": "integer", "minimum": 1},
          "exploration": {
            "type": "object",
            "required": [
              "candidate_count",
              "implemented_count",
              "parked_unimplemented_count",
              "candidate_results",
              "gradient_hypotheses",
              "search_globally_exhausted"
            ],
            "properties": {
              "candidate_count": {"type": "integer", "minimum": 2},
              "implemented_count": {"type": "integer", "minimum": 1},
              "parked_unimplemented_count": {"type": "integer", "minimum": 0},
              "candidate_results": {"type": "array", "minItems": 2},
              "gradient_hypotheses": {"type": "array", "minItems": 1},
              "search_globally_exhausted": {"const": false}
            },
            "additionalProperties": true
          },
          "gate": {
            "type": "object",
            "required": [
              "baseline_candidate",
              "target_candidate",
              "survivors",
              "minimal_survivor_frontier",
              "drive_survivors",
              "controls",
              "status"
            ],
            "properties": {
              "baseline_candidate": {"type": "string", "minLength": 1},
              "target_candidate": {"type": "string", "minLength": 1},
              "survivors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "minimal_survivor_frontier": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "drive_survivors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "controls": {"type": "array", "minItems": 1},
              "status": {
                "enum": [
                  "PROVISIONAL_TOOTH_WITHIN_PACKET",
                  "NO_LIFT_NEEDED__DIG_CONTINUES",
                  "UNRESOLVED_GATE__DIG_CONTINUES"
                ]
              }
            },
            "additionalProperties": true
          },
          "receipt": {
            "type": "object",
            "required": [
              "what_was_provisionally_earned",
              "what_was_killed",
              "what_was_parked",
              "projection_back_down",
              "residual_exposed_by_projection",
              "claim_ceiling",
              "self_promotes_to_physical_model"
            ],
            "properties": {
              "what_was_provisionally_earned": {"type": "array", "items": {"type": "string"}},
              "what_was_killed": {"type": "array", "items": {"type": "string"}},
              "what_was_parked": {"type": "array", "items": {"type": "string"}},
              "projection_back_down": {"type": "string", "minLength": 1},
              "residual_exposed_by_projection": {"type": "string", "minLength": 1},
              "claim_ceiling": {"const": "formal_finite_packet_provisional"},
              "self_promotes_to_physical_model": {"const": false}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "gates_run",
        "provisional_teeth",
        "teeth",
        "scientific_manifold_layers_admitted",
        "global_search_exhausted",
        "run_boundary",
        "terminal_hold_asserted"
      ],
      "properties": {
        "gates_run": {"type": "integer", "minimum": 1},
        "provisional_teeth": {"type": "integer", "minimum": 0},
        "teeth": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scientific_manifold_layers_admitted": {"type": "integer", "minimum": 0},
        "global_search_exhausted": {"const": false},
        "run_boundary": {"const": "FINITE_BUDGET_REACHED__SEARCH_AND_REOPENING_REMAIN_ACTIVE"},
        "terminal_hold_asserted": {"const": false}
      },
      "additionalProperties": true
    },
    "open_dig_queue": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "status": {"const": "RUN_COMPLETE_WITH_OPEN_DIG_QUEUE"}
  },
  "additionalProperties": true
}
