{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-ratchet/ratchet-card/v1",
  "title": "Codex Ratchet Card v1",
  "$comment": "Passing this structural schema is not scientific admission. The Python validator applies cross-field and receipt checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "card_id", "classification", "promotion_allowed",
    "formal_admission_allowed", "source_manifest", "claim", "root_record",
    "constraints", "predecessor_receipts", "candidate_search", "mss",
    "earned_structures", "co_views", "recursive_loop", "controls",
    "independent_recomputation", "fabrication_audit", "decision",
    "blocked_consumers", "next_obligation", "ca_hypothesis", "receipts"
  ],
  "properties": {
    "schema": {"const": "codex_ratchet.ratchet_card.v1"},
    "card_id": {"type": "string", "minLength": 1},
    "classification": {
      "enum": ["process_proposal", "scratch_diagnostic", "ratchet_survivor", "rejected", "superseded"]
    },
    "promotion_allowed": {"type": "boolean"},
    "formal_admission_allowed": {"type": "boolean"},
    "source_manifest": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_text", "scope", "ceiling", "demotion_conditions", "required_earned_structures"],
      "properties": {
        "exact_text": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "ceiling": {"type": "string", "minLength": 1},
        "demotion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_earned_structures": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["probe_family", "equivalence_relation", "quotient", "objects", "measure", "updates"]}
        }
      }
    },
    "root_record": {
      "type": "object", "additionalProperties": false,
      "required": [
        "primitive", "marks_are_objects", "finite_marks",
        "finite_distinction_attempts", "finite_history_prefix",
        "delta_codomain", "probe_family_earned", "equivalence_relation_earned"
      ],
      "properties": {
        "primitive": {"const": "constrained_distinction_records"},
        "marks_are_objects": {"const": false},
        "finite_marks": {"const": true},
        "finite_distinction_attempts": {"const": true},
        "finite_history_prefix": {"const": true},
        "delta_codomain": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["DISTINGUISHABLE", "INDISTINGUISHABLE", "UNRESOLVED"]}
        },
        "probe_family_earned": {"type": "boolean"},
        "equivalence_relation_earned": {"type": "boolean"}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["F01", "N01", "supplied_structures"],
      "properties": {
        "F01": {
          "type": "object", "additionalProperties": false,
          "required": ["finite_realization", "continuum_empirically_refuted"],
          "properties": {
            "finite_realization": {"const": true},
            "continuum_empirically_refuted": {"const": false}
          }
        },
        "N01": {
          "type": "object", "additionalProperties": false,
          "required": ["typed_same_start_required", "future_effect_required", "static_filter_control_required"],
          "properties": {
            "typed_same_start_required": {"const": true},
            "future_effect_required": {"const": true},
            "static_filter_control_required": {"const": true}
          }
        },
        "supplied_structures": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "predecessor_receipts": {"type": "array", "items": {"$ref": "#/$defs/predecessor"}},
    "candidate_search": {
      "type": "object", "additionalProperties": false,
      "required": [
        "universe_model", "generator", "generator_variants",
        "candidate_families", "breadth_justification", "coverage_claim",
        "stop_rule", "sealed_target_suite_sha256", "unsearched_region"
      ],
      "properties": {
        "universe_model": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1},
        "generator_variants": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "candidate_families": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "breadth_justification": {"type": "string", "minLength": 1},
        "coverage_claim": {"type": "string", "minLength": 1},
        "stop_rule": {"type": "string", "minLength": 1},
        "sealed_target_suite_sha256": {"$ref": "#/$defs/sha256"},
        "unsearched_region": {"type": "string", "minLength": 1}
      }
    },
    "mss": {
      "type": "object", "additionalProperties": false,
      "required": [
        "weakness_preorder", "preorder_variants", "update_family_variants",
        "plural_minima_allowed", "frontier", "robust_core",
        "sensitivity_union", "empty_frontier_outcome",
        "frontier_execution_rule", "defeasible", "weaker_candidate_demotion"
      ],
      "properties": {
        "weakness_preorder": {
          "type": "object", "additionalProperties": false,
          "required": ["definition", "status", "version"],
          "properties": {
            "definition": {"type": "string", "minLength": 1},
            "status": {"const": "installed_and_defeasible"},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "preorder_variants": {"type": "array", "minItems": 2},
        "update_family_variants": {"type": "array", "minItems": 2},
        "plural_minima_allowed": {"const": true},
        "frontier": {"type": "array"},
        "robust_core": {"type": "array"},
        "sensitivity_union": {"type": "array"},
        "empty_frontier_outcome": {"const": "NO_SURVIVOR_BLOCKS_ADMISSION"},
        "frontier_execution_rule": {"const": "FAN_OUT_ALL_UNLESS_REMOVED_BY_RECEIPT"},
        "defeasible": {"const": true},
        "weaker_candidate_demotion": {"const": true}
      }
    },
    "earned_structures": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_family", "equivalence_relation", "quotient", "objects", "measure", "updates"],
      "properties": {
        "probe_family": {"$ref": "#/$defs/statusEvidence"},
        "equivalence_relation": {"$ref": "#/$defs/statusEvidence"},
        "quotient": {"$ref": "#/$defs/statusEvidence"},
        "objects": {"$ref": "#/$defs/statusEvidence"},
        "measure": {"$ref": "#/$defs/statusEvidence"},
        "updates": {"$ref": "#/$defs/statusEvidence"}
      }
    },
    "co_views": {
      "type": "object", "additionalProperties": false,
      "required": ["shared_boundary_id", "neither_view_prior", "geometry", "entropy", "admission_driven_by_views"],
      "properties": {
        "shared_boundary_id": {"type": "string", "minLength": 1},
        "neither_view_prior": {"const": true},
        "geometry": {"$ref": "#/$defs/view"},
        "entropy": {"$ref": "#/$defs/view"},
        "admission_driven_by_views": {"const": false}
      }
    },
    "recursive_loop": {
      "type": "object", "additionalProperties": false,
      "required": [
        "passes_required", "passes_run", "raw_recomputation_required",
        "residual_returns_as_new_obligation", "obligation_generation_rule_sha256",
        "raw_record_sha256", "derived_cache_forbidden", "branch_rule"
      ],
      "properties": {
        "passes_required": {"type": "integer", "minimum": 2},
        "passes_run": {"type": "integer", "minimum": 0},
        "raw_recomputation_required": {"const": true},
        "residual_returns_as_new_obligation": {"const": true},
        "obligation_generation_rule_sha256": {"$ref": "#/$defs/sha256"},
        "raw_record_sha256": {"$ref": "#/$defs/sha256"},
        "derived_cache_forbidden": {"const": true},
        "branch_rule": {"const": "RULE_CHANGE_OPENS_NEW_BRANCH"}
      }
    },
    "controls": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/control"}},
    "independent_recomputation": {
      "type": "object", "additionalProperties": false,
      "required": ["required_lanes", "completed_lanes", "agreement_receipt"],
      "properties": {
        "required_lanes": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "completed_lanes": {"type": "array", "items": {"type": "string"}},
        "agreement_receipt": {"type": ["string", "null"]}
      }
    },
    "fabrication_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "fresh_context", "receipt"],
      "properties": {
        "status": {"type": "string"},
        "fresh_context": {"type": "boolean"},
        "receipt": {"type": ["string", "null"]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "claim_ceiling", "receipt", "receipt_parent_hash", "mss_frontier_hash", "status_index_path", "status_index_sha256"],
      "properties": {
        "status": {"enum": ["UNRUN", "ACCEPT_PROVISIONAL", "PARK", "REJECT", "GRAVEYARD_KEEP", "SUPERSEDED_BY_WEAKER"]},
        "claim_ceiling": {"type": "string"},
        "receipt": {"type": ["string", "null"]},
        "receipt_parent_hash": {"type": ["string", "null"]},
        "mss_frontier_hash": {"type": ["string", "null"]},
        "status_index_path": {"type": ["string", "null"]},
        "status_index_sha256": {"type": ["string", "null"]}
      }
    },
    "blocked_consumers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_obligation": {"type": "string", "minLength": 1},
    "ca_hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "alternatives", "required_gates"],
      "properties": {
        "status": {"enum": ["candidate", "rejected", "accept_provisional"]},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "required_gates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "receipts": {"type": "array", "items": {"$ref": "#/$defs/receiptRef"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "statusEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "evidence": {"type": "array"}
      }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_id", "type", "license", "recomputed", "receipt"],
      "properties": {
        "boundary_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "recomputed": {"const": true},
        "receipt": {"type": ["string", "null"]}
      }
    },
    "receiptRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"type": "string", "minLength": 1}
      }
    },
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "status", "flip_expected", "receipt"],
      "properties": {
        "class": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "flip_expected": {"type": "boolean"},
        "receipt": {"type": ["object", "null"]}
      }
    }
  }
}
