{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-ratchet.engine-job.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bridge_id", "job_id", "engine_profile", "fixture", "fixture_sha256", "requested_outputs"],
  "properties": {
    "schema": {"const": "codex-ratchet.engine-job.v1"},
    "bridge_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "engine_profile": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "minLength": 1},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "seed": {"type": "integer", "minimum": 0}
  }
}
